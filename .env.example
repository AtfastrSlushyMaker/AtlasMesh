# Copy to .env (repo root or server/). Everything is optional: AtlasMesh runs
# with free, keyless sources, and each variable below unlocks more.

# --- Live feeds ---------------------------------------------------------
# OpenSky API client (https://opensky-network.org/my-opensky/account).
# Without it aircraft refresh about every 15 minutes; with it, every minute.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Legacy OpenSky basic-auth accounts still work:
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Ships (free key from https://aisstream.io)
AISSTREAM_TOKEN=

# --- Intel workspace -----------------------------------------------------
# AI analyst (DeepSeek, OpenAI-compatible). Without a key a rules-based
# analyst answers common questions.
DEEPSEEK_API_KEY=
# Any OpenAI-compatible provider works too:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Protects the Intel workspace. Strongly recommended on any public deployment:
# without it anyone can run investigations and spend the LLM key.
OSINT_ACCESS_KEY=

# Higher rate limits for connectors (all optional)
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
S2_API_KEY=
CERTSPOTTER_TOKEN=

# Where investigations are stored (default: server/data/osint)
# OSINT_DATA_DIR=
# Where large public datasets are cached (default: server/.cache)
# ATLAS_CACHE_DIR=

# --- Server --------------------------------------------------------------
PORT=3000
# Comma-separated extra origins allowed to call the API in production
# ALLOWED_ORIGINS=
